// Prisma schema for the streaming backend.
// NOTE: This file is the source of truth for persisted stream state.
// Recurring schedules (#221) are modeled here so that each generated
// stream instance is independently funded, identified, and cancellable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stream {
  id              String   @id @default(cuid())
  sender          String
  recipient       String
  token           String
  amount          String
  startTime       DateTime
  endTime         DateTime
  status          StreamStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sentStreams     Stream[] @relation("SentStreams")
  receivedStreams Stream[] @relation("ReceivedStreams")

  @@index([publicKey])
}

// Stream model - mirrors on-chain stream state for fast querying
model Stream {
  id                String    @id @default(uuid())
  streamId          BigInt    @unique // On-chain stream ID (Soroban u64)
  sender            String    // Sender's Stellar public key
  recipient         String    // Recipient's Stellar public key
  tokenAddress      String    // Token contract address
  ratePerSecond     String    // Rate as string to preserve precision (i128)
  depositedAmount   String    // Total deposited amount (i128)
  withdrawnAmount   String    // Total withdrawn amount (i128)
  startTime         BigInt    // Unix timestamp when stream started
  lastUpdateTime    BigInt    // Unix timestamp of last update
  endTime           BigInt?   // Unix timestamp when stream ends
  isActive          Boolean   @default(true)
  isPaused          Boolean   @default(false)
  pausedAt          BigInt?   // Unix timestamp when paused
  totalPausedDuration Int     @default(0) // Accumulated paused duration in seconds
  version           Int       @default(0) // Optimistic-concurrency guard for stale stream mutations
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  senderUser        User      @relation("SentStreams", fields: [sender], references: [publicKey])
  recipientUser     User      @relation("ReceivedStreams", fields: [recipient], references: [publicKey])
  events            StreamEvent[]
  releasePolicy     StreamReleasePolicy?

  @@unique([scheduleId, scheduleIndex])
  @@index([sender])
  @@index([recipient])
  @@index([tokenAddress])
  @@index([isActive])
  @@index([isPaused])
}

// StreamReleasePolicy model - verifier-backed conditional release policy (issue #214).
//
// A stream may be gated so that accrual/release only happens once a configured
// verifier returns a positive result. Trust assumptions are explicit:
//   * `verifierAddress` is the ONLY trusted identity. Results signed by any other
//     key are rejected; the verifier is trusted to answer honestly for the
//     `policyKey` it is asked about (it is NOT trusted to move funds).
//   * `timeoutSeconds` bounds how long a pending verification may block release.
//     On timeout the stream falls back to `onTimeout` (default: keep locked).
//   * `onFailure` defines behavior when the verifier is unavailable or returns a
//     malformed response (default: keep locked, never auto-release).
//   * Replay protection: each verification result carries a unique `nonce`; the
//     `(streamId, nonce)` pair is unique so a replayed result cannot release twice.
model StreamReleasePolicy {
  id              String   @id @default(uuid())
  streamId        BigInt   @unique
  verifierAddress String   // Trusted verifier Stellar public key (G...)
  policyKey       String   // Opaque key the verifier answers about
  timeoutSeconds  Int      @default(3600) // Max wait before onTimeout applies
  onTimeout       String   @default("LOCK") // "LOCK" | "RELEASE"
  onFailure       String   @default("LOCK") // "LOCK" | "RELEASE"
  lastNonce       String?  // Highest accepted verifier nonce (replay guard)
  isReleased      Boolean  @default(false)
  releasedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stream          Stream   @relation(fields: [streamId], references: [streamId], onDelete: Cascade)
  results         VerifierResult[]

  @@index([verifierAddress])
  @@index([isReleased])
}

// VerifierResult model - records verifier responses for audit and replay defense.
// `(policyId, nonce)` is unique so a replayed verifier result is rejected at the
// storage layer, independent of application-level checks.
model VerifierResult {
  id          String   @id @default(uuid())
  policyId    String
  nonce       String   // Unique per verifier response; replay guard
  approved    Boolean
  rawResponse String?  // Original response payload for audit/debugging
  receivedAt  DateTime @default(now())

  policy      StreamReleasePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, nonce])
  @@index([policyId])
  @@index([receivedAt])
}

// IndexerState model - tracks the last processed ledger/cursor for the Soroban event worker.
//
// Concurrency contract (issue #43): replay, reset, and normal polling all mutate
// this single row. Writers MUST take a row-level lock (SELECT ... FOR UPDATE) on
// the singleton row inside a transaction before reading or advancing the cursor,
// so an admin replay cannot race the live worker or move the cursor backwards.
// The `version` column is an optimistic-concurrency guard: every write bumps it
// and callers that observed a stale version must retry. `lastCursor` is only ever
// advanced monotonically (never regressed) by the poll loop; replay/reset are the
// only operations allowed to rewind it, and they do so under the same lock.
model IndexerState {
  id          String   @id @default("singleton")
  lastLedger  Int      @default(0)
  lastCursor  String?  // Paging token of the last processed event (for cursor-based pagination)
  version     Int      @default(0) // Optimistic-concurrency guard; bumped on every write
  updatedAt   DateTime @updatedAt
}

// IndexerContractConfig model - per-contract indexing configuration (issue #247).
//
// Each row describes one contract deployment the indexer should follow. The
// network passphrase is part of the identity, so the same contract address
// deployed on testnet and mainnet are two distinct configurations with fully
// isolated cursors, event schemas, and network identity. The legacy singleton
// `IndexerState` row is retained for backward compatibility; when no
// configuration exists the worker falls back to it.
model IndexerContractConfig {
  id                 String   @id @default(uuid())
  contractAddress    String   // Soroban contract address (C...)
  networkPassphrase  String   // Stellar network passphrase identifying the network
  startLedger        Int      @default(0) // Inclusive ledger to begin indexing from
  lastLedger         Int      @default(0) // Last ledger successfully processed
  lastCursor         String?  // Paging token of the last processed event for this deployment
  eventSchemaVersion Int      @default(1) // Version of the event schema this deployment emits
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  events             StreamEvent[]

  @@unique([contractAddress, networkPassphrase])
  @@index([contractAddress, networkPassphrase])
  @@index([enabled])
}

// LedgerCheckpoint model - durable proof of the exact ledger sequence, hash
// signature, and event count the indexer ingested. Written on every ingestion
// cycle so the worker can (a) prove the canonical chain still contains what it
// indexed and (b) roll back deterministically when a fork replaces it.
//
// Snapshot contract (issue #228): the highest non-reverted ledgerSequence is the
// single indexed checkpoint that ledger-consistent multi-resource snapshots are
// pinned to. Stream, event, and balance reads for a snapshot MUST be filtered to
// ledgerSequence <= that checkpoint so clients never combine data from different
// ledgers. When the indexer lags behind the chain tip, the snapshot reports
// staleness metadata and clients should retry rather than merge results.
model LedgerCheckpoint {
  ledgerSequence Int      @id
  ledgerHash     String
  parentHash     String
  processedAt    DateTime @default(now())
  eventsCount    Int
  stateRootHash  String?
  isReverted     Boolean  @default(false)

  @@index([processedAt])
  @@index([isReverted, ledgerSequence])
}

// StreamEvent model - indexer events for tracking all on-chain stream activities
model StreamEvent {
  id              String   @id @default(uuid())
  streamId        BigInt   // Reference to on-chain stream ID (Soroban u64)
  eventType       String   // EventType: "CREATED", "TOPPED_UP", "WITHDRAWN", "CANCELLED", "COMPLETED", "PAUSED", "RESUMED"
  amount          String?  // Amount involved in the event (for top-ups, withdrawals)
  transactionHash String   // Stellar transaction hash
  ledgerSequence  Int      // Ledger sequence number
  timestamp       BigInt   // Unix timestamp
  metadata        String?  // JSON string for additional event data
  configId        String?  // IndexerContractConfig this event was ingested under (issue #247)
  createdAt       DateTime @default(now())

  // Relations
  stream          Stream   @relation(fields: [streamId], references: [streamId])
  config          IndexerContractConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@unique([transactionHash, eventType])
  @@index([configId])
  @@index([streamId])
  @@index([eventType])
  @@index([streamId, eventType])
  @@index([timestamp])
  @@index([transactionHash])
  @@index([createdAt])
  @@index([streamId, timestamp])
  // Canonical ordering index: (streamId, ledgerSequence) gives deterministic
  // blockchain-ordered event listings. ledger_sequence is the total order on
  // Stellar — no two events in different ledgers share a sequence number.
  @@index([streamId, ledgerSequence])
  // Snapshot index (issue #228): supports ledger-bounded event reads for a
  // single checkpoint (ledgerSequence <= checkpoint) without a full scan.
  @@index([ledgerSequence])
}

enum StreamStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// BackfillJob model - tracks historical backfill operations for bounded ledger ranges.

// Organization model - groups wallet-linked members under a shared identity for
// payroll and subscription workflows (issue #233). Personal wallet ownership and
// signing authority remain distinct from organization membership: a wallet owns
// its own key pair and signs on its own behalf; membership only grants the right
// to act on organization-scoped resources according to a role (issue #234).
//
// `network` is part of the organization identity so the same slug cannot be
// reused across Stellar networks to collide on organization-scoped resources
// (issue #236).
model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String
  network       String   // Stellar network the organization is scoped to (testnet/mainnet)
  ownerWalletAddress String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]

  @@unique([slug, network])
  @@index([network])
  @@index([ownerWalletAddress])
}

// OrganizationMember model - a wallet's membership within an organization,
// carrying the role that determines which organization-scoped actions the
// wallet may perform (issue #234).
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  walletAddress  String
  role           OrganizationRole @default(MEMBER)
  invitedBy      String?    // Wallet that issued the invitation, if any
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, walletAddress])
  @@index([organizationId])
  @@index([walletAddress])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

// OrganizationInvitation model - a pending membership invitation. Invitations
// are single-use, time-bound, and can be revoked before acceptance (issue #233).
model OrganizationInvitation {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  walletAddress    String   // Wallet the invitation is addressed to
  role             OrganizationRole @default(MEMBER)
  token            String   @unique // Single-use acceptance token
  status           OrganizationInvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
  @@index([walletAddress])
  @@index([status])
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
