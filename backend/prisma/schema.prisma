// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// User model - represents Stellar wallet addresses interacting with the protocol
model User {
  id              String   @id @default(uuid())
  publicKey       String   @unique // Stellar public key (G...)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sentStreams     Stream[] @relation("SentStreams")
  receivedStreams Stream[] @relation("ReceivedStreams")

  @@index([publicKey])
}

// Stream model - mirrors on-chain stream state for fast querying
model Stream {
  id                String    @id @default(uuid())
  streamId          BigInt    @unique // On-chain stream ID (Soroban u64)
  sender            String    // Sender's Stellar public key
  recipient         String    // Recipient's Stellar public key
  tokenAddress      String    // Token contract address
  ratePerSecond     String    // Rate as string to preserve precision (i128)
  depositedAmount   String    // Total deposited amount (i128)
  withdrawnAmount   String    // Total withdrawn amount (i128)
  startTime         BigInt    // Unix timestamp when stream started
  lastUpdateTime    BigInt    // Unix timestamp of last update
  endTime           BigInt?   // Unix timestamp when stream ends
  isActive          Boolean   @default(true)
  isPaused          Boolean   @default(false)
  pausedAt          BigInt?   // Unix timestamp when paused
  totalPausedDuration Int     @default(0) // Accumulated paused duration in seconds
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  senderUser        User      @relation("SentStreams", fields: [sender], references: [publicKey])
  recipientUser     User      @relation("ReceivedStreams", fields: [recipient], references: [publicKey])
  events            StreamEvent[]

  @@index([sender])
  @@index([recipient])
  @@index([tokenAddress])
  @@index([isActive])
  @@index([isPaused])
  // Deterministic cursor pagination (Issue #73): stable ordering across equal
  // timestamps and concurrent inserts. `id` is the tiebreaker.
  @@index([createdAt, id])
  @@index([sender, createdAt, id])
  @@index([recipient, createdAt, id])

  // Query-plan-backed composite indexes for list/history/analytics reads.
  // See docs/indexes.md for the EXPLAIN ANALYZE before/after evidence.
  @@index([isActive, isPaused, startTime])
  @@index([sender, startTime])
  @@index([recipient, startTime])
}

// IndexerState model - tracks the last processed ledger/cursor for the Soroban event worker
model IndexerState {
  id          String   @id @default("singleton")
  lastLedger  Int      @default(0)
  lastCursor  String?  // Paging token of the last processed event (for cursor-based pagination)
  updatedAt   DateTime @updatedAt
}

// IndexerLease model - single-row (id = "singleton") renewable lease that
// coordinates poll ownership across backend replicas. Only the replica whose
// ownerId matches and whose expiresAt is in the future may advance the cursor.
// fencingToken is monotonically incremented on every acquisition so stale
// owners can be rejected when they attempt to write after a lease turnover.
model IndexerLease {
  id           String   @id @default("singleton")
  ownerId      String?  // Identity of the current poll owner (null when free)
  expiresAt    DateTime? // Lease expiry; owner must renew before this instant
  fencingToken BigInt   @default(0) // Incremented on each acquisition; guards stale writes
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

// LedgerCheckpoint model - durable proof of the exact ledger sequence, hash
// signature, and event count the indexer ingested. Written on every ingestion
// cycle so the worker can (a) prove the canonical chain still contains what it
// indexed and (b) roll back deterministically when a fork replaces it.
model LedgerCheckpoint {
  ledgerSequence Int      @id
  ledgerHash     String
  parentHash     String
  processedAt    DateTime @default(now())
  eventsCount    Int
  stateRootHash  String?
  isReverted     Boolean  @default(false)

  @@index([processedAt])
}

// StreamEvent model - indexer events for tracking all on-chain stream activities
model StreamEvent {
  id              String   @id @default(uuid())
  streamId        BigInt   // Reference to on-chain stream ID (Soroban u64)
  eventType       String   // EventType: "CREATED", "TOPPED_UP", "WITHDRAWN", "CANCELLED", "COMPLETED", "PAUSED", "RESUMED"
  amount          String?  // Amount involved in the event (for top-ups, withdrawals)
  transactionHash String   // Stellar transaction hash
  ledgerSequence  Int      // Ledger sequence number
  timestamp       BigInt   // Unix timestamp
  metadata        String?  // JSON string for additional event data
  createdAt       DateTime @default(now())

  // Relations
  stream          Stream   @relation(fields: [streamId], references: [streamId])

  @@unique([transactionHash, eventType])
  @@index([streamId])
  @@index([eventType])
  @@index([streamId, eventType])
  @@index([timestamp])
  @@index([transactionHash])
  @@index([createdAt])
  @@index([streamId, timestamp])
  // Deterministic cursor pagination (Issue #73): stable ordering across equal
  // timestamps and concurrent inserts. `id` is the tiebreaker.
  @@index([timestamp, id])
  @@index([streamId, timestamp, id])
  // Query-plan-backed composite indexes for event history/cursor reads.
  // See docs/indexes.md for the EXPLAIN ANALYZE before/after evidence.
  @@index([streamId, ledgerSequence])
  @@index([ledgerSequence, timestamp])
}

// WebhookSubscription model - Outgoing webhook configuration for external integrations (Issue #1189)
// Lifecycle (Issue #59): endpoints are soft-deleted via deletedAt so delivery
// history and replay audit records survive deletion. Disabling is recorded with
// disabledAt/disabledReason and is distinct from deletion.
model WebhookSubscription {
  id                      String    @id @default(uuid())
  userAddress             String    // Stellar public key of the owner
  targetUrl               String    // Destination webhook URL (must be HTTPS)
  secretKey               String    // AES-256-GCM envelope encrypted
  previousSecretKey       String?   // Encrypted prior key during bounded rotation overlap
  previousSecretExpiresAt DateTime?
  eventTypes              String[]  // Array of subscribed event types (e.g., ["STREAM_CREATED", "TOKENS_WITHDRAWN"])
  isActive                Boolean   @default(true)
  disabledAt              DateTime? // When the endpoint was disabled (null when enabled)
  disabledReason          String?   // Operator/user supplied reason for disabling
  deletedAt               DateTime? // Soft-delete marker; non-null endpoints are treated as gone
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  deliveries  WebhookDelivery[]
  replays     WebhookDeliveryReplay[]

  @@index([userAddress])
  @@index([isActive])
  @@index([deletedAt])
  @@index([userAddress, deletedAt])
}

// Append-only record for security-sensitive operational changes.
model AuditEvent {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now())
  actor      String
  requestId  String?
  action     String
  targetType String
  targetId   String
  outcome    String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  metadata   Json?    @db.JsonB

  @@index([occurredAt])
  @@index([targetType, targetId])
  @@index([actor, occurredAt])
}

// WebhookDelivery model - Webhook delivery history and retry tracking (Issue #1189)
// status (Issue #59) lets scoped replay select only FAILED deliveries, so
// successful deliveries are never resent.
model WebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  eventType      String
  payload        String   // JSON
  status         String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  responseStatus Int?
  attempts       Int      @default(0)
  deliveredAt    DateTime?
  error          String?
  createdAt      DateTime @default(now())

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status])
  @@index([subscriptionId, status, createdAt])
}

// WebhookDeliveryReplay model - Audit record for scoped replay requests (Issue #59)
// One row per replay request; deliveryIds is the bounded set of failed
// deliveries that were re-enqueued. outcome is "SUCCEEDED", "PARTIAL", or
// "FAILED" and is updated as the replay progresses.
model WebhookDeliveryReplay {
  id             String   @id @default(uuid())
  replayId       String   @unique // Client/operator supplied idempotency key for the replay
  subscriptionId String
  deliveryIds    String[] // Bounded set of delivery ids selected for replay
  requestedBy    String   // Stellar public key of the requester (ownership checked)
  requestedAt    DateTime @default(now())
  outcome        String   @default("PENDING") // "PENDING" | "SUCCEEDED" | "PARTIAL" | "FAILED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([subscriptionId, requestedAt])
  @@index([requestedBy])
  @@index([outcome])
  @@index([requestedAt])
}

// AlertHistory model - Tracks sent alerts to prevent duplicate notifications (Issue #1190)
//
// Idempotency contract (Issue #55): a runway notification is identified by the
// deterministic tuple (streamId, alertType, windowStart) where `windowStart` is
// the start of the notification window the alert belongs to (e.g. the 48h or
// 24h runway boundary, truncated to the policy's window granularity). The unique
// constraint guarantees that restarts, clock skew within a window, and parallel
// worker replicas can insert a given window at most once; concurrent inserts
// surface as a unique-violation (P2002) which the worker treats as "already
// notified". `sentAt` is retained for observability but is no longer part of the
// uniqueness key.
model AlertHistory {
  id          String   @id @default(uuid())
  streamId    BigInt
  alertType   String   // "WARNING_48H" or "CRITICAL_24H"
  windowStart DateTime // Deterministic start of the notification window
  sentAt      DateTime @default(now())

  @@unique([streamId, alertType, windowStart])
  @@index([streamId])
  @@index([sentAt])
  @@index([windowStart])
}

// WebhookOutbox model - Transactional outbox for webhook delivery (Issue #57)
//
// Outbox rows are written in the same database transaction as the business
// change (stream event / state change) that produces them, so a committed
// change always has a deliverable event. A separate dispatcher polls rows in
// `PENDING`/`FAILED` state whose `nextAttemptAt` has elapsed and delivers them
// with bounded retries, persisting attempt state durably. `dedupeKey` is unique
// so retries or re-emission of the same logical event never create duplicate
// outbox records.
model WebhookOutbox {
  id             String    @id @default(uuid())
  subscriptionId String
  eventType      String
  payload        String    // JSON
  dedupeKey      String    @unique // e.g. `${eventType}:${txHash}:${subscriptionId}`
  status         String    @default("PENDING") // "PENDING" | "DELIVERED" | "FAILED" | "DEAD"
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([subscriptionId])
  @@index([createdAt])
}

// OperationalAlertState model - Deduplication and recovery state for
// operator-facing alerts (Issue #56). One row per logical alert condition
// (`alertKey`); `state` transitions between "firing" and "resolved" so a
// sustained condition notifies once and a recovery emits exactly one
// resolution notification. `metadata` holds non-secret context only.
model OperationalAlertState {
  id             String    @id @default(uuid())
  alertKey       String    @unique
  condition      String    // e.g. "DEAD_LETTER_GROWTH", "INDEXER_LAG", "RPC_FAILURE"
  state          String    @default("firing") // "firing" | "resolved"
  firstFiredAt   DateTime  @default(now())
  lastNotifiedAt DateTime?
  resolvedAt     DateTime?
  metadata       String?   // JSON, must not contain secrets or raw event payloads
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([condition])
  @@index([state])
}

// WebhookReplayNonce model - Replay prevention for signed webhook payloads
// (Issue #58). Each accepted signed request records its nonce with an expiry;
// a nonce seen again before `expiresAt` is rejected as a replay. Expired rows
// are pruned by a maintenance job.
model WebhookReplayNonce {
  nonce     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// IndexerDeadLetterEvent model - quarantines Soroban events whose processing
// failed (unexpected payload shape, transient DB lock, RPC timeout mid-handler).
// A quarantined event is never retried inline by the poll loop, so one malformed
// event cannot freeze the worker cursor; operators replay or discard it through
// the admin dead-letter endpoints instead.
model IndexerDeadLetterEvent {
  id             String   @id @default(uuid())
  eventId        String   // Soroban paging token / event id of the quarantined event
  eventType      String   // Contract event name, e.g. "stream_created"
  txHash         String   // Stellar transaction hash
  ledgerSequence Int      // Ledger the event was emitted in
  cursor         String?  // Paging token captured alongside the event
  payload        String   // JSON envelope: base64 XDR for each topic ScVal + value ScVal
  errorMessage   String   // Failure reason from the processing attempt
  attempts       Int      @default(1)
  lastAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([eventId, eventType])
  @@index([ledgerSequence])
  @@index([createdAt])
  @@index([attempts])
  @@index([eventType])
}

// IdempotencyRecord model - durable idempotency contract for retryable stream
// commands that submit on-chain transactions (Issue #74). A key is bound to the
// wallet, operation, and request hash so a retry with identical input replays the
// original result, while key reuse with different input is rejected. Records are
// retained for a bounded window and purged via `expiresAt`.
model IdempotencyRecord {
  id             String   @id @default(uuid())
  wallet         String   // Stellar public key of the caller
  operation      String   // Command identifier, e.g. "stream.create"
  idempotencyKey String   // Client-supplied key
  requestHash    String   // Hash of the canonical request payload
  status         String   @default("IN_FLIGHT") // "IN_FLIGHT" | "SUCCEEDED" | "FAILED"
  response       String?  // Serialized result payload (JSON)
  expiresAt      DateTime // Bounded retention; rows past this are purgeable
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([wallet, operation, idempotencyKey])
  @@index([expiresAt])
  @@index([wallet, operation])
}
