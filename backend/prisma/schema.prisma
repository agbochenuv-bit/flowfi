// Prisma schema for the streaming backend.
// NOTE: This file is the source of truth for persisted stream state.
// Recurring schedules (#221) are modeled here so that each generated
// stream instance is independently funded, identified, and cancellable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stream {
  id              String   @id @default(cuid())
  sender          String
  recipient       String
  token           String
  amount          String
  startTime       DateTime
  endTime         DateTime
  status          StreamStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Deterministic linkage to a recurring schedule (#221).
  // Null for standalone streams; set for instances spawned by a schedule.
  scheduleId      String?
  scheduleIndex   Int?
  schedule        RecurringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduleIndex])
  @@index([sender])
  @@index([recipient])
}

enum StreamStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Bounded recurring schedule (#221).
// Limits are enforced at the contract/API layer; the schema stores the
// declared bounds so instances can be derived deterministically.
model RecurringSchedule {
  id              String   @id @default(cuid())
  sender          String
  recipient       String
  token           String
  // Per-instance funding amount; each instance is funded independently.
  amountPerInstance String
  // Interval between instance start times, in seconds.
  intervalSeconds Int
  // First instance start time.
  startTime       DateTime
  // Maximum number of instances that may be spawned from this schedule.
  maxInstances    Int
  // Number of instances already spawned (monotonic; guards duplicate execution).
  spawnedCount    Int      @default(0)
  // Duration of each instance, in seconds.
  instanceDurationSeconds Int
  status          ScheduleStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances       Stream[]

  @@index([sender])
  @@index([status])
}

enum ScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
