# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy to `.env` and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database connection (blue-green cutover)
# ---------------------------------------------------------------------------
# Primary (blue) endpoint — the currently active database.
DATABASE_URL=postgres://user:password@blue-db.internal:5432/app

# Standby (green) endpoint — the verified cutover target.
# Leave empty when no cutover is in progress.
DATABASE_URL_GREEN=

# Which endpoint receives writes: `blue` or `green`.
# Only switch to `green` after the readiness check passes.
DATABASE_ACTIVE_ENDPOINT=blue

# Readiness check: how long to wait for the target DB to accept connections
# before aborting the cutover (milliseconds).
DATABASE_CUTOVER_READY_TIMEOUT_MS=10000

# Readiness check: interval between connection probes (milliseconds).
DATABASE_CUTOVER_PROBE_INTERVAL_MS=500

# Rollback: automatically revert to the previous endpoint if the target
# fails readiness or the post-cutover health check.
DATABASE_CUTOVER_AUTO_ROLLBACK=true

# Rollback: how long to keep the previous endpoint warm for rollback
# after a successful cutover (milliseconds).
DATABASE_CUTOVER_ROLLBACK_WINDOW_MS=300000

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Secrets must be supplied by the secret manager, not committed here.
# See docs/operations for the secret manager integration.

# Secret-manager provider. Supported: `env` (default, reads the plaintext
# variables below), `aws-secrets-manager`, `gcp-secret-manager`, `vault`.
# When a non-`env` provider is set, the plaintext variables below are ignored
# and resolved from the provider instead.
SECRET_MANAGER_PROVIDER=env

# Provider connection settings (only used when SECRET_MANAGER_PROVIDER != env).
# AWS: region + optional endpoint override. GCP: project id. Vault: address.
SECRET_MANAGER_REGION=
SECRET_MANAGER_PROJECT=
SECRET_MANAGER_ADDRESS=

# Map of logical secret name -> provider reference (ARN / resource id / path).
# The backend resolves these at startup and on refresh. Example:
#   SECRET_MANAGER_REFS={"signingKey":"arn:aws:secretsmanager:...","databaseUrl":"..."}
SECRET_MANAGER_REFS=

# Startup semantics: `fail-fast` aborts boot if a required secret cannot be
# resolved; `degraded` boots using cached/env fallback and surfaces a warning.
SECRET_MANAGER_STARTUP_MODE=fail-fast

# Refresh/rotation: interval between background re-fetches (milliseconds).
# Set to 0 to disable periodic refresh (on-demand only).
SECRET_MANAGER_REFRESH_INTERVAL_MS=300000

# Failure semantics: retry/backoff when the provider is unavailable.
SECRET_MANAGER_RETRY_MAX_ATTEMPTS=5
SECRET_MANAGER_RETRY_BASE_DELAY_MS=200
SECRET_MANAGER_RETRY_MAX_DELAY_MS=10000

# Plaintext fallback values (used only when SECRET_MANAGER_PROVIDER=env or
# when SECRET_MANAGER_STARTUP_MODE=degraded and the provider is unavailable).
# Never commit real values here.
SIGNING_KEY=
